{
  "manifest_version": 3,
  "name": "Sleeper Rankings",
  "version": "1.3.0",
  "description": "Weekly Sleeper rankings, lineup check and trade ideas, next to your own Sleeper leagues.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Sleeper Rankings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "bg.js",
    "scripts": ["lib/core.js", "lib/data.js", "storage.js", "alerts.js", "bg.js"]
  },
  "permissions": ["storage", "sidePanel", "alarms", "notifications"],
  "host_permissions": [
    "https://api.sleeper.app/*",
    "https://api.sleeper.com/*",
    "https://sleeper.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://sleeper.com/leagues/*"],
      "js": ["lib/core.js", "lib/data.js", "storage.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "sidebar_action": {
    "default_panel": "panel.html",
    "default_title": "Sleeper Rankings"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sleeper-rankings@etanetan.github.io",
      "strict_min_version": "140.0",
      "update_url": "https://etanetan.github.io/sleeper-rankings/extension/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
